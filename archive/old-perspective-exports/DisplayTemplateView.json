    "custom.TagRange.noLimit": {
      "binding": {
        "config": {
          "struct": {
            "highRange": "{view.custom.TagRange.HighRange}",
            "lowRange": "{view.custom.TagRange.LowRange}",
            "rawValue": "{view.custom.Value.rawValue}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\thighRange \u003d value.highRange\n\tlowRange \u003d value.lowRange\n\trawValue \u003d value.rawValue\n\toneRangeNull \u003d (highRange is None) or (lowRange is None)\n\tbothAreZero \u003d (highRange \u003d\u003d 0) and (lowRange \u003d\u003d 0)\n\tnotNumber \u003d (isinstance(rawValue,str) or isinstance(rawValue, bool))\n\treturn oneRangeNull or bothAreZero or notNumber",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.Value": {
      "persistent": true
    },
    "custom.Value.Value": {
      "binding": {
        "config": {
          "struct": {
            "tagValue": "{view.custom.Value.rawValue}",
            "textOnFalse": "{view.params.textOnFalse}",
            "textOnTrue": "{view.params.textOnTrue}",
            "units": "{view.custom.Value.units}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttagValue \u003d value.tagValue\n\tunits \u003d value.units\n\n\tif isinstance(tagValue,bool):\n\t\tif tagValue:\n\t\t\toutputValue \u003d value.textOnTrue\n\t\telse:\n\t\t\toutputValue \u003d value.textOnFalse\n\t\tself.custom.loadDone \u003d True\n\t\treturn outputValue\n\tif isinstance(tagValue,float):\n\t\tself.custom.loadDone \u003d True\n\t\tprecision \u003d self.custom.Value.precision\n\t\tform \u003d \u0027{:.%d\u0027%precision + \u0027f}\u0027\t\t\n\t\treturn \"%s %s\"%(form.format(round(tagValue,precision)), units)\n\tif isinstance(tagValue, int):\n\t\tself.custom.loadDone \u003d True\t\n\t\treturn \"%s %s\"%(str(tagValue), units)\n\tself.custom.loadDone \u003d True\n\treturn tagValue",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.Value.backgroundColor": {
      "binding": {
        "config": {
          "struct": {
            "highRange": "{view.custom.TagRange.HighRange}",
            "lowRange": "{view.custom.TagRange.LowRange}",
            "noLimit": "{view.custom.TagRange.noLimit}",
            "transparent": "{view.params.transparent}",
            "val": "{view.custom.Value.rawValue}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tval \u003d value.val\n\thighRange \u003d value.highRange\n\tlowRange \u003d value.lowRange\n\ttransparent \u003d value.transparent\n\tnoLimit \u003d value.noLimit\n\t#Color if value is None, meaning PLC disconnect\n\tif val is None:\n\t\treturn \"#FFFF004B\"\n\t#If the value is an int or float, return color based on bounds\n\tif isinstance(val, int) or isinstance(val, float):\n\t\t#if high range or low range is not defined, then use standard color\n\t\tif noLimit:\n\t\t\treturn \u0027--warm-gray-3-c-tint-30\u0027 if not transparent else \u0027transparent\u0027\n\t\t#Color if value is out of high end bounds\n\t\tif val \u003e highRange:\n\t\t\treturn \"#FF00004B\"\n\t\t#Color if value is out of low end bounds\n\t\telif val \u003c lowRange:\n\t\t\treturn \"#0000FF4B\"\n\t\t#standard color if all is within range\n\t\telse:\n\t\t\tif transparent:\n\t\t\t\treturn \u0027transparent\u0027\n\t\t\treturn \u0027--warm-gray-3-c-tint-30\u0027\n\t#If not a float or int, return normal\n\treturn \u0027--warm-gray-3-c-tint-30\u0027 if not transparent else \u0027transparent\u0027",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.Value.basis": {
      "binding": {
        "config": {
          "expression": "if({view.params.evenRow} \u003d true, \"50%\", \"auto\")"
