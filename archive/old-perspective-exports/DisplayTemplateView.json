    "custom.TagRange": {
      "persistent": true
    },
    "custom.TagRange.HighRange": {
      "binding": {
        "config": {
          "expression": "tag({view.params.TagPath} + \u0027.EngHigh\u0027)"
        },
        "type": "expr"
      },
