    "scripts": {
      "customMethods": [
        {
          "name": "AddTrend",
          "params": [],
          "script": "\tself.view.custom.CTG.trendcheck \u003d True\n\tTagName \u003d self.view.custom.CTG.PenName.lower()\n\tTagPath \u003d self.view.params.TagPath.lower()\n\tself.meta.contextMenu.enabled \u003d False\n\tself.view.custom.Value.cursor \u003d \u0027progress\u0027\n\tgl.ClickToGraph.AddTagTrend(self.session.custom,TagName,TagPath)\n\tself.meta.contextMenu.enabled \u003d True\n\tself.view.refreshBinding(\u0027custom.Value.cursor\u0027)\n\tself.view.refreshBinding(\u0027custom.CTG.trendcheck\u0027)"
        },
        {
          "name": "RefreshTrending",
          "params": [],
          "script": "#\t# implement your method here\n\tself.view.refreshBinding(\u0027custom.CTG.trendcheck\u0027)\n#\t# * * * OBSOLETE * * * \n#\t# checks to see if tag is trending already and updates prop\n#\tresult \u003d gl.ClickToGraph.CheckifTrending(self.session.custom, TagPath)\n##\tsystem.perspective.print(result)\n#\tself.view.custom.trendcheck \u003d result"
        },
        {
          "name": "ContextBuilder",
          "params": [
            "TrendCheck"
          ],
          "script": "\t# * * * DEPRICATED * * * * -\u003e keeping incase of future need\n\t# implement your method here\n\t# rebuilds the context menu based on trend check changes / page startup\n\tTagName \u003d self.view.custom.CTG.PenName.lower()\n\tTagPath \u003d self.view.params.TagPath.lower()\n\tContextMenu \u003d []\n\tif TrendCheck \u003d\u003d False:\n\t\t# --------- ADD TREND TEMPLATE --------------\n\t\tAddTrendTemplate \u003d {\n\t\t  \"children\": [],\n\t\t  \"icon\": {\n\t\t    \"color\": \"\",\n\t\t    \"path\": \"material/trending_up\",\n\t\t    \"style\": {}\n\t\t  },\n\t\t  \"link\": {\n\t\t    \"target\": \"self\",\n\t\t    \"url\": \"\"\n\t\t  },\n\t\t  \"message\": {\n\t\t    \"payload\": {},\n\t\t    \"scope\": \"page\",\n\t\t    \"type\": \"\"\n\t\t  },\n\t\t  \"method\": {\n\t\t    \"name\": \"AddTrend\",\n\t\t    \"params\": {}\n\t\t  },\n\t\t  \"style\": {\n\t\t    \"classes\": \"\"\n\t\t  },\n\t\t  \"text\": \"Trend Tag\",\n\t\t  \"type\": \"method\"\n\t\t}\n\t\tContextMenu.append(AddTrendTemplate)\n\telse:\n\t\t# --------- REMOVE TREND TEMPLATE --------------\n\t\tRemoveTrendTemplate \u003d {\n\t\t\t\"children\": [],\n\t\t\t\"icon\": {\n\t\t\t\"color\": \"\",\n\t\t\t\"path\": \"material/remove_circle\",\n\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"link\": {\n\t\t\t\"target\": \"self\",\n\t\t\t\"url\": \"\"\n\t\t\t},\n\t\t\t\"message\": {\n\t\t\t\"payload\": {},\n\t\t\t\"scope\": \"page\",\n\t\t\t\"type\": \"\"\n\t\t\t},\n\t\t\t\"method\": {\n\t\t\t\"name\": \"RemoveTrend\",\n\t\t\t\"params\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\"classes\": \"\"\n\t\t\t},\n\t\t\t\"text\": \"Remove Trend\",\n\t\t\t\"type\": \"method\"\n\t\t}\n\t\tContextMenu.append(RemoveTrendTemplate)\n\t\n\t# --------- TRENDED TAG MANAGER --------------\n\tmanagerTemplate \u003d {\n\t  \"children\": [],\n\t  \"icon\": {\n\t\t\"color\": \"\",\n\t\t\"path\": \"material/settings\",\n\t\t\"style\": {}\n\t  },\n\t  \"link\": {\n\t\t\"target\": \"self\",\n\t\t\"url\": \"\"\n\t  },\n\t  \"message\": {\n\t\t\"type\": \"\",\n\t\t\"payload\": {},\n\t\t\"scope\": \"page\"\n\t  },\n\t  \"style\": {\n\t\t\"classes\": \"\"\n\t  },\n\t  \"method\": {\n\t\t\"name\": \"ManagerPopup\",\n\t\t\"params\": {}\n\t  },\n\t  \"type\": \"method\",\n\t  \"text\": \"Manage Trending\"\n\t}\n\tContextMenu.append(managerTemplate)\n\t\n\t# --------- REFRESH CT MENU TEMPLATE --------------\n\trefreshcheck \u003d {\n\t  \"children\": [],\n\t  \"icon\": {\n\t    \"color\": \"\",\n\t    \"path\": \"material/refresh\",\n\t    \"style\": {}\n\t  },\n\t  \"link\": {\n\t    \"target\": \"self\",\n\t    \"url\": \"\"\n\t  },\n\t  \"message\": {\n\t    \"payload\": {},\n\t    \"scope\": \"page\",\n\t    \"type\": \"\"\n\t  },\n\t  \"method\": {\n\t    \"name\": \"RefreshTrending\",\n\t    \"params\": {}\n\t  },\n\t  \"style\": {\n\t    \"classes\": \"\"\n\t  },\n\t  \"text\": \"Refresh Options\",\n\t  \"type\": \"method\"\n\t}\n\tContextMenu.append(refreshcheck)\n\t\n\t\n\t# --------- PRINT CT MENU TEMPLATE --------------\n\tPrintTemplate \u003d {\n\t  \"text\": \"Print CT Menu\",\n\t  \"icon\": {\n\t    \"path\": \"material/local_printshop\",\n\t    \"color\": \"\",\n\t    \"style\": {}\n\t  },\n\t  \"style\": {\n\t    \"classes\": \"\"\n\t  },\n\t  \"type\": \"method\",\n\t  \"children\": [],\n\t  \"link\": {\n\t    \"url\": \"\",\n\t    \"target\": \"self\"\n\t  },\n\t  \"method\": {\n\t    \"name\": \"PrintContextMenu\",\n\t    \"params\": {\n\t    }\n\t  },\n\t  \"message\": {\n\t    \"type\": \"\",\n\t    \"payload\": {},\n\t    \"scope\": \"page\"\n\t  }\n\t}\n#\tContextMenu.append(PrintTemplate)\n\t\n\t# return full menu\n\treturn ContextMenu"
        },
        {
          "name": "RemoveTrend",
          "params": [],
          "script": "\t# implement your method here\n\tTagPath \u003d self.view.custom.CTG.PenName.lower()\n\tgl.ClickToGraph.RemoveTagTrend(self.session.custom, TagPath)\n\tself.view.custom.CTG.trendcheck \u003d False\n\tself.view.refreshBinding(\u0027custom.CTG.trendcheck\u0027)"
        },
        {
          "name": "PrintContextMenu",
          "params": [],
          "script": "\t# prints context menu for debug purpose, enable through Context builder method\n\tTagName \u003d self.view.custom.CTG.PenName.lower()\n\tTagPath \u003d self.view.params.TagPath.lower()\n\tContextMenu \u003d self.meta.contextMenu.items"
        },
        {
          "name": "ManagerPopup",
          "params": [],
          "script": "\tsystem.perspective.openPopup(\u0027TagTrendManager\u0027, \u0027global/Global Popups/TagTrendManager\u0027, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)"
        },
        {
          "name": "ClearTrend",
          "params": [],
          "script": "\tCustomProps \u003d self.session.custom\n\tgl.ClickToGraph.ClearTrend(CustomProps)"
        },
        {
          "name": "EditTagConfig",
          "params": [],
          "script": "\tisEngineer \u003d self.session.custom.Security.CanPerformMaintenanceActivity\n\tcanEditTags \u003d self.view.custom.EditTag.canEditTag\n\ttagPath \u003d self.view.params.TagPath.replace(\"/Value\",\"\").lower()\n\t#If as persmission and can edit tags open tag editor\n\tif isEngineer and canEditTags:\n\t\tview \u003d \"global/Global Popups/EditTagConfig\"\n\t\tid \u003d \"EditTagConfig\"\n\t\tparams \u003d {\u0027tagPath\u0027:tagPath}\n\t\ttitle \u003d \"Edit Configuration for %s\"%tagPath.split(\u0027/\u0027)[-1]\n\t#If has permission and can\u0027t edit tags open maintenance\n\telif isEngineer and not canEditTags:\n\t\tview \u003d \"global/Global Popups/MessageBox\"\n\t\tid \u003d \"message\"\n\t\tparams \u003d {\u0027message\u0027:\"Maintenance is being performed on the tags, try again later.\"}\n\t\ttitle \u003d \"Warning\"\n\telse:\n\t\tview \u003d \"global/Global Popups/MessageBox\"\n\t\tid \u003d \"message\"\n\t\tparams \u003d {\u0027message\u0027:\"You are not authorized to edit tags.\"}\n\t\ttitle \u003d \"Warning\"\n\t\n\tsystem.perspective.openPopup(id, view, params\u003dparams, showCloseIcon \u003d False, title \u003d title, draggable \u003d True, resizable \u003d True)"
        },
        {
          "name": "ViewTrend",
          "params": [],
          "script": "\t# implement your method here\n\tsystem.perspective.navigate(\u0027Trending\u0027)"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "RefreshContext",
          "pageScope": true,
          "script": "\t# Refresh context\n\tself.view.refreshBinding(\u0027custom.CTG.trendcheck\u0027)",
          "sessionScope": false,
          "viewScope": false
        }
      ]
