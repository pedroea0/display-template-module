      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t#Get params and security\n\tisSetPoint \u003d self.view.params.setpoint\n\thasRole \u003d self.session.custom.Security.CanRunOperations\n\tinSecurityZone \u003d self.session.custom.Security.inSecurityZone\n\t#Check if label is setpoint and if user has correct security\n\tif isSetPoint:\n\t\tif hasRole and inSecurityZone:\n\t\t\tTagPath \u003d self.view.params.TagPath\n\t\t\ttitle \u003d self.view.custom.ValueSetter.Name\n\t\t\tunits \u003d self.view.custom.Value.units if self.view.custom.Value.units is not None else \"\"\n\t\t\tid \u003d \"ValueSetterPopup\"\n\t\t\tview \u003d \"global/Global Popups/ValueSetter\"\n\t\t\ttitle \u003d \"Set Value for \" + title + \" (\" + units + \")\"\n\t\t\tparams \u003d {\u0027tagPath\u0027:TagPath}\n\t\t\tposition \u003d {\u0027width\u0027:\u0027auto\u0027,\u0027height\u0027:\u0027auto\u0027}\n\t\t\tshowCloseIcon \u003d False\n\t\t\tresizable \u003d True\n\t\t\tmodal \u003d True\n\t\t\tsystem.perspective.openPopup(id, view, title\u003dtitle, params\u003dparams, modal\u003dmodal, showCloseIcon\u003dshowCloseIcon, resizable\u003dresizable, position\u003dposition)\n\t\telse:\n\t\t\t#Does not have permission open no permission popup\n\t\t\tidentifier \u003d self.view.params.TagPath\n\t\t\tparams \u003d {\"Name\":identifier}\n\t\t\t#Get position of mouse and middle point of popup to open it at center of mouse\n\t\t\tx \u003d event.clientX - 203.5\n\t\t\ty \u003d event.clientY - 64.5\n\t\t\tposition \u003d {\u0027left\u0027:x,\u0027top\u0027:y}\n\t\t\tsystem.perspective.openPopup(id\u003didentifier, view\u003d\"global/Global Popups/PID/Permission Denied\",position\u003dposition,params \u003d params, showCloseIcon \u003d False, draggable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue, viewportBound \u003d True)\n\t"
              },
              "scope": "G",
              "type": "script"
            }
