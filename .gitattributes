# =============================================================================
# Line endings
# -----------------------------------------------------------------------------
# The browser cache buster (RESOURCE_VERSION) hashes every byte under
# gateway/src/main/resources/mounted, and the build id hashes every entry of the
# three jars (schemas and mounted files included). With core.autocrlf=true a
# Windows checkout turns LF into CRLF, so the same commit built on two machines
# (or in two worktrees with different settings) would give two different "versions".
# Pinning these files to LF in the working tree makes both hashes depend on the
# commit only.
#
# Scripts that Windows tools read keep CRLF (*.bat, *.cmd, *.ps1).
# =============================================================================

# ---- module sources and resources: always LF -----------------------------------
*.java        text eol=lf
*.kts         text eol=lf
*.gradle      text eol=lf
*.js          text eol=lf
*.mjs         text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.properties  text eol=lf
*.txt         text eol=lf
*.html        text eol=lf
*.svg         text eol=lf
*.xml         text eol=lf
*.py          text eol=lf
*.md          text eol=lf
gradlew       text eol=lf

# ---- Windows scripts: CRLF -----------------------------------------------------
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# ---- binaries ---------------------------------------------------------------------
*.jar         binary
*.jks         binary
*.modl        binary
*.png         binary
*.ico         binary
*.zip         binary
