{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": { "direction": "column" },
    "children": [
      {
        "type": "com.example.simpletagdisplay.SimpleTagDisplay",
        "meta": { "name": "Full" },
        "props": {
          "tagPath": "[default]CTG/TempSP",
          "showTagName": false,
          "showTagValue": true,
          "tagNameLabel": "Setpoint",
          "valuePrecision": 3,
          "row": true,
          "evenRow": true,
          "verticalAlign": "bottom",
          "showUnits": true,
          "boolean": { "textOnTrue": "ON", "textOnFalse": "OFF" },
          "bounds": { "enabled": true, "minColor": "#0000FF", "maxColor": "#FF00FF", "minInclusive": true, "maxInclusive": true },
          "setpoint": true,
          "tagNameStyle": { "classes": "label-cls", "color": "#333333" },
          "tagValueStyle": { "classes": "", "fontWeight": "bold" },
          "style": { "classes": "card", "backgroundColor": "#FAFAFA" }
        }
      },
      {
        "type": "com.example.simpletagdisplay.CtgChart",
        "meta": { "name": "FullChart" },
        "props": {
