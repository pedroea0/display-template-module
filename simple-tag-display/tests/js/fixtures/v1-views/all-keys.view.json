          "rangeHours": 1.5,
          "pointCount": 20000,
          "rawHistory": true,
          "freeRangePanZoom": false,
          "refreshRate": 100,
          "startDate": "2026-01-02T03:04:05Z",
          "endDate": "2026-01-03T00:00:00.000Z",
          "dateFormat": "DD.MM.YYYY",
          "timeFormat": "HH:mm",
