            "showDateRangeSelector": false,
            "showPenControlDisplay": false,
            "showRefreshButton": false,
            "showZoomButton": false,
            "showFullscreenButton": false
          },
          "interaction": { "mode": "selection", "xTraceVisible": false },
          "style": { "classes": "trend" }
        }
      },
      {
        "type": "com.example.simpletagdisplay.CtgChart",
        "meta": { "name": "ReducerKeys" },
        "props": {
          "rangeHours": 168,
          "refreshRate": 0,
          "pointCount": 0,
          "visibility": {
            "showModeToggle": false,
            "showRangePresets": false,
            "showRefreshRateControl": true,
            "showLegend": false
          }
        }
      }
    ]
