          "mode": "realtime",
          "pointCount": 300,
          "rangeHours": 24,
          "rawHistory": false,
          "refreshRate": 1000,
          "startDate": null,
          "style": {
            "classes": ""
          },
          "timeFormat": "h:mm A",
          "visibility": {
            "showDateRangeSelector": true,
            "showFullscreenButton": true,
            "showPenControlDisplay": true,
            "showRefreshButton": true,
            "showZoomButton": true
          }
        },
        "type": "com.example.simpletagdisplay.CtgChart"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
