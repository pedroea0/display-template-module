# =============================================================================
# Build artifacts — regenerated by Gradle; safe to delete at any time
# =============================================================================
build/
bin/
.gradle/
out/
target/

# =============================================================================
# Local notes and editor settings (not part of the module)
# -----------------------------------------------------------------------------
# Release notes, to-do lists and parked 1.x material are kept on the
# maintainer's disk only. User-facing limitations are documented in
# docs/user-guide/known-limitations.md; requests and bugs go to GitHub issues.
# =============================================================================
/V2_REPORT.md
/BACKLOG.md
/archive/
.vscode/

# Presentation material (slide decks and speaker notes). Not part of the module.
presentation/
story.txt

# =============================================================================
# Local dev configuration — contains gateway URLs and API tokens.
# NEVER commit these. Use deploy_config.example.json as the template.
# =============================================================================
*.local.json
*.local.py
.env
.env.local

# =============================================================================
# Production keystores
# -----------------------------------------------------------------------------
# The dev keystore (simpletagdisplay.jks / .p7b) IS intentionally committed —
# it's a self-signed dev-only credential. If you generate your own production
# keystore, name it something else (e.g. prod.jks) and the pattern below will
# keep it out of git.
# =============================================================================
prod*.jks
prod*.p7b
# PKCS#12 keystores (docs/developer-guide/07-signing.md: a CA-issued key usually arrives as .pfx/.p12). None is
# committed, so every name is ignored, not only prod*.
*.pfx
*.p12
*.keystore
secrets/

# =============================================================================
# IDE
# =============================================================================
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Logs / temp
# =============================================================================
*.log
*.tmp

# =============================================================================
# AI assistant context files (local to each developer)
# =============================================================================
CLAUDE.md
.claude/

# =============================================================================
# Local working material (never published — repo is public)
# =============================================================================
.work/
ignition-automation-tools/
*.vtt
__pycache__/
