# =============================================================================
# Build artifacts — regenerated by Gradle; safe to delete at any time
# =============================================================================
build/
bin/
.gradle/
out/
target/

# Reference clones of public Inductive Automation repos — re-cloneable, just bloat in this repo
archive/reference-repos/

# Presentation material — ~48 MB of .pptx (deck + corporate template) plus personal
# speaker notes. Keep it out of the repo; it is not part of the module.
presentation/
story.txt

# =============================================================================
# Local dev configuration — contains gateway URLs and API tokens.
# NEVER commit these. Use deploy_config.example.json as the template.
# =============================================================================
*.local.json
*.local.py
.env
.env.local

# =============================================================================
# Production keystores
# -----------------------------------------------------------------------------
# The dev keystore (simpletagdisplay.jks / .p7b) IS intentionally committed —
# it's a self-signed dev-only credential. If you generate your own production
# keystore, name it something else (e.g. prod.jks) and the pattern below will
# keep it out of git.
# =============================================================================
prod*.jks
prod*.p7b
*.keystore
secrets/

# =============================================================================
# IDE
# =============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Logs / temp
# =============================================================================
*.log
*.tmp

# =============================================================================
# AI assistant context files (local to each developer)
# =============================================================================
CLAUDE.md
.claude/
